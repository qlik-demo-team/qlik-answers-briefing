# Copy this file to ".env" and fill in the values for your tenant:
#   cp .env.example .env
# These values are inlined into the browser bundle at build time, so keep them public. Never put a
# client secret here. A Single-page-app OAuth client is public and has no secret.

# Your Qlik Cloud tenant URL.
VITE_QLIK_HOST=https://your-tenant.us.qlikcloud.com

# The Qlik Sense app the briefing runs against (its GUID, from the app URL).
VITE_APP_ID=00000000-0000-0000-0000-000000000000

# The Single-page-app OAuth client id from your tenant. Register its redirect URL and allowed origin
# as this app's origin, for example https://localhost:3000/ in development.
VITE_OAUTH_CLIENT_ID=your-oauth-client-id

# Optional. Base path if you deploy the build into a subfolder rather than the domain root.
# The registered OAuth redirect URL must equal your deployed origin plus this base.
# VITE_BASE=/
